{
  "name": "spirekeeper",
  "version": "1.1.0",
  "description": "Local multiplayer save manager for Slay the Spire 2",
  "main": "build/main.cjs",
  "author": "Spirekeeper",
  "license": "MIT",
  "scripts": {
    "compile": "tsc && node scripts/prepare-build.cjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run compile && electron .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:ui": "npm run compile && node test/ui-smoke.cjs",
    "build": "npm run compile && electron-builder --win portable --x64",
    "format": "node scripts/space-source.cjs && prettier --write src test scripts package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src test scripts package.json tsconfig.json .prettierrc.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "local.spirekeeper.desktop",
    "productName": "Spirekeeper",
    "compression": "store",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "build/steam-helper.ps1"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Spirekeeper-${version}.exe",
      "useZip": true
    }
  }
}
